# copy to .env and fill in; the API and the batch app refuse to start without the required values

# ports
PORT_API=3007
PORT_BATCH=3008

# required: MongoDB connection strings (MONGO_PROD is used when NODE_ENV=production)
MONGO_DEV=
MONGO_PROD=

# required by the API: secret used to sign JWTs (use a long random string)
SECRET_TOKEN=

# required by the API: secret that signs ticket QR tokens (HMAC); use a long random string, different from SECRET_TOKEN
QR_SECRET=

# seconds a seat hold (and an unpaid general-admission order) lasts; optional, whole number 1 to 3600, default 30
SEAT_HOLD_SECONDS=30

# allowed browser origin(s) for CORS, comma-separated (defaults to http://localhost:3000 outside production)
CLIENT_URL=http://localhost:3000

# used only by `npm run seed` to create the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI features (moderation, translation, assistant); all optional. AI stays off unless AI_ENABLED=true and the key of the selected provider is set
AI_ENABLED=false
# anthropic (default) or gemini; only the selected provider's variables are read
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# defaults to claude-haiku-4-5 (small and cheap)
ANTHROPIC_MODEL=
GEMINI_API_KEY=
# defaults to gemini-2.5-flash (flash models have a free tier)
GEMINI_MODEL=
# per-request timeout in ms (1000 to 120000, default 15000) and requests per member (or IP) per minute (default 10)
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_MINUTE=10

# used only by `npm run seed:demo` (demo accounts, venues, events, orders); the password is optional, default Demo1234!
DEMO_PASSWORD=
# `npm run seed:demo` refuses to run when NODE_ENV=production unless this is true
ALLOW_DEMO_SEED=false
