# copy to .env and fill in; the API and the batch app refuse to start without the required values

# ports
PORT_API=3007
PORT_BATCH=3008

# required: MongoDB connection strings (MONGO_PROD is used when NODE_ENV=production)
MONGO_DEV=
MONGO_PROD=

# required by the API: secret used to sign JWTs (use a long random string)
SECRET_TOKEN=

# required by the API: secret that signs ticket QR tokens (HMAC); use a long random string, different from SECRET_TOKEN
QR_SECRET=

# payment mode: `simulated` = mock provider, the buyer picks the result (demo only); `disabled` = payOrder refuses every payment.
# optional outside production (default simulated); REQUIRED in production, there is no default. No real provider exists yet
PAYMENT_MODE=simulated

# listening port (the host sets it; falls back to PORT_API, then 3000), and how many proxies sit in front of the API
PORT=
TRUST_PROXY_HOPS=

# exact browser origins for CORS, comma-separated (required in production; CLIENT_URL above is the older name)
CORS_ORIGINS=

# optional limits and switches; empty means the default (see RUN_IN_PRODUCTION.md). NODE_ENV=production is set by `npm run start:prod`
RATE_LIMIT_GENERAL_PER_MINUTE=
RATE_LIMIT_LOGIN_PER_15_MIN=
RATE_LIMIT_SIGNUP_PER_HOUR=
RATE_LIMIT_PASSWORD_PER_15_MIN=
AI_DAILY_CAP=
AI_PER_KEY_DAILY_CAP=
UPLOAD_MAX_FILE_MB=
UPLOAD_MAX_FILES=
LOG_LEVEL=
MONGO_AUTO_INDEX=

# seconds a seat hold (and an unpaid general-admission order) lasts; optional, whole number 1 to 3600, default 30
SEAT_HOLD_SECONDS=120

# allowed browser origin(s) for CORS, comma-separated (defaults to http://localhost:3000 outside production)
CLIENT_URL=http://localhost:3000

# used only by `npm run seed` to create the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# optional second admin, also created only by `npm run seed` and only when both are set and the email is unused (nick is optional)
ADMIN2_EMAIL=
ADMIN2_PASSWORD=
ADMIN2_NICK=

# AI features (moderation, translation, assistant); all optional. AI stays off unless AI_ENABLED=true and the key of the selected provider is set
AI_ENABLED=false
# anthropic (default) or gemini; only the selected provider's variables are read
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# defaults to claude-haiku-4-5 (small and cheap)
ANTHROPIC_MODEL=
GEMINI_API_KEY=
# defaults to gemini-2.5-flash (flash models have a free tier)
GEMINI_MODEL=
# optional: a second Gemini model tried once when the main one fails with 404/429/503/504 or a timeout (after the one retry). Empty = no fallback
GEMINI_FALLBACK_MODEL=
# per-request timeout in ms (1000 to 120000, default 15000; the AI client retries once after a timeout, 503 or 504) and requests per member (or IP) per minute (default 10)
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_MINUTE=10

# demo data: `npm run seed:demo`, `reset:demo` (and the read-only `check:demo`). Choose strong values (12+ characters, 3 kinds of
# characters, no common words); the seed refuses a missing or weak one. Never commit real values.
DEMO_BUYER_PASSWORD=
DEMO_ORGANIZER_PASSWORD=
DEMO_PENDING_ORGANIZER_PASSWORD=
DEMO_REJECTED_ORGANIZER_PASSWORD=
# seed and reset refuse to run unless this names the database variable they should use: MONGO_DEV or MONGO_PROD
DEMO_SEED_CONFIRM=
# a database that holds data the seed did not create is refused unless this is true
DEMO_SEED_ALLOW_NON_DEMO_DB=false
# with NODE_ENV=production the demo commands also need this to be true
ALLOW_DEMO_SEED=false
