# copy to .env and fill in; the API and the batch app refuse to start without the required values

# ports
PORT_API=3007
PORT_BATCH=3008

# required: MongoDB connection strings (MONGO_PROD is used when NODE_ENV=production)
MONGO_DEV=
MONGO_PROD=

# required by the API: secret used to sign JWTs (use a long random string)
SECRET_TOKEN=

# required by the API: secret that signs ticket QR tokens (HMAC); use a long random string, different from SECRET_TOKEN
QR_SECRET=

# seconds a seat hold (and an unpaid general-admission order) lasts; optional, whole number 1 to 3600, default 30
SEAT_HOLD_SECONDS=30

# allowed browser origin(s) for CORS, comma-separated (defaults to http://localhost:3000 outside production)
CLIENT_URL=http://localhost:3000

# used only by `npm run seed` to create the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
